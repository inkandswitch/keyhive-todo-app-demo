{
  "name": "keyhive-demo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:linked": "node scripts/check-linked-freshness.mjs",
    "gen:phonebook-id": "node scripts/generate-phonebook-id.mjs",
    "lint": "eslint . && prettier --check \"**/*.{ts,tsx,js,mjs}\"",
    "lint:fix": "eslint . --fix && prettier --write \"**/*.{ts,tsx,js,mjs}\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@automerge/automerge": "catalog:",
    "@automerge/automerge-repo": "catalog:",
    "@automerge/automerge-repo-keyhive": "catalog:",
    "@automerge/automerge-repo-storage-indexeddb": "catalog:",
    "@automerge/automerge-subduction": "catalog:",
    "@automerge/keyhive-react": "catalog:",
    "@automerge/react": "catalog:",
    "@inkandswitch/onomancy": "catalog:",
    "@keyhive/keyhive": "catalog:",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-use": "^17.6.0",
    "vite-plugin-wasm": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.5.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "fast-check": "^4.9.0",
    "globals": "^15.0.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^5.4.20",
    "vitest": "^2.1.9"
  }
}
